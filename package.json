    "watch:global-css-fa-less": "less-watch-compiler elements/fa elements/fa",
    "build:global-css-iox-less": "lessc elements/iox/global-style.less elements/iox/global-style.css",
    "watch:global-css-iox-less": "less-watch-compiler elements/iox elements/iox"
